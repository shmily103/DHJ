{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build DHJ Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug",
                "--target",
                "DHJ"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash Latest DHJ Debug",
            "dependsOn": "Build DHJ Debug",
            "dependsOrder": "sequence",
            "type": "process",
            "command": "/opt/homebrew/bin/openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "program {${workspaceFolder}/build/Debug/DHJ.elf} verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build DHJ Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Release",
                "--target",
                "DHJ"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash Latest DHJ Release",
            "dependsOn": "Build DHJ Release",
            "dependsOrder": "sequence",
            "type": "process",
            "command": "/opt/homebrew/bin/openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "program {${workspaceFolder}/build/Release/DHJ.elf} verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
